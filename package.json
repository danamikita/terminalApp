{
  "name": "folderminal",
  "version": "1.6.31",
  "description": "Folder-organized terminal session manager",
  "main": "dist/electron/main.js",
  "scripts": {
    "postinstall": "patch-package",
    "build": "tsc",
    "start": "electron .",
    "dev": "tsc && electron .",
    "drive": "node scripts/electron-drive.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bonjour-service": "^1.4.4",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "marked": "^18.1.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.pragmaticbytes.folderminal",
    "productName": "Folderminal",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "danamikita",
      "repo": "terminalApp",
      "releaseType": "release"
    }
  },
  "author": "danamikita"
}
